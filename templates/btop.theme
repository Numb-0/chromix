# Generated by chromix from a matugen template. Changes are lost on the
# next theme switch.

# Only drawn with theme_background = True; otherwise the terminal's own.
theme[main_bg]="{{colors.surface.default.hex}}"
theme[main_fg]="{{colors.on_surface.default.hex}}"
theme[title]="{{colors.on_surface.default.hex}}"
theme[hi_fg]="{{colors.primary.default.hex}}"
theme[selected_bg]="{{colors.primary_container.default.hex}}"
theme[selected_fg]="{{colors.on_primary_container.default.hex}}"
theme[inactive_fg]="{{colors.outline.default.hex}}"
theme[graph_text]="{{colors.on_surface_variant.default.hex}}"
theme[meter_bg]="{{colors.surface_container_highest.default.hex}}"
theme[proc_misc]="{{colors.tertiary.default.hex}}"

theme[proc_banner_bg]="{{colors.secondary_container.default.hex}}"
theme[proc_banner_fg]="{{colors.on_secondary_container.default.hex}}"
theme[followed_bg]="{{colors.tertiary_container.default.hex}}"
theme[followed_fg]="{{colors.on_tertiary_container.default.hex}}"
theme[proc_follow_bg]="{{colors.tertiary_container.default.hex}}"
theme[proc_pause_bg]="{{colors.error_container.default.hex}}"

theme[cpu_box]="{{colors.outline_variant.default.hex}}"
theme[mem_box]="{{colors.outline_variant.default.hex}}"
theme[net_box]="{{colors.outline_variant.default.hex}}"
theme[proc_box]="{{colors.outline_variant.default.hex}}"
theme[div_line]="{{colors.outline_variant.default.hex}}"

# Gradients run start (low) -> mid -> end (high). Load and heat go
# through the fixed green, yellow and red so a hot CPU reads as hot
# whatever the seed; the rest stay in the scheme's own roles.
theme[temp_start]="{{colors.green.default.hex}}"
theme[temp_mid]="{{colors.yellow.default.hex}}"
theme[temp_end]="{{colors.red.default.hex}}"

theme[cpu_start]="{{colors.green.default.hex}}"
theme[cpu_mid]="{{colors.yellow.default.hex}}"
theme[cpu_end]="{{colors.red.default.hex}}"

theme[used_start]="{{colors.green.default.hex}}"
theme[used_mid]="{{colors.yellow.default.hex}}"
theme[used_end]="{{colors.red.default.hex}}"

theme[free_start]="{{colors.primary_container.default.hex}}"
theme[free_mid]="{{colors.primary.default.hex}}"
theme[free_end]="{{colors.inverse_primary.default.hex}}"

theme[cached_start]="{{colors.secondary_container.default.hex}}"
theme[cached_mid]="{{colors.secondary.default.hex}}"
theme[cached_end]="{{colors.on_secondary_container.default.hex}}"

theme[available_start]="{{colors.tertiary_container.default.hex}}"
theme[available_mid]="{{colors.tertiary.default.hex}}"
theme[available_end]="{{colors.on_tertiary_container.default.hex}}"

theme[download_start]="{{colors.primary_container.default.hex}}"
theme[download_mid]="{{colors.primary.default.hex}}"
theme[download_end]="{{colors.on_primary_container.default.hex}}"

theme[upload_start]="{{colors.tertiary_container.default.hex}}"
theme[upload_mid]="{{colors.tertiary.default.hex}}"
theme[upload_end]="{{colors.on_tertiary_container.default.hex}}"

theme[process_start]="{{colors.primary.default.hex}}"
theme[process_mid]="{{colors.tertiary.default.hex}}"
theme[process_end]="{{colors.error.default.hex}}"
