  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "{{colors.outline.default.hex}}",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "{{colors.on_surface.default.hex}}"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "{{colors.on_surface_variant.default.hex}}"
      }
    },
    {
      "scope": [
        "variable.language",
        "variable.other.readwrite.alias",
        "entity.name.tag",
        "support.variable"
      ],
      "settings": {
        "foreground": "{{colors.red.default.hex}}"
      }
    },
    {
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "constant.character.escape",
        "support.constant",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "{{colors.orange.default.hex}}"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "{{colors.yellow.default.hex}}"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "{{colors.yellow.default.hex}}"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "markup.inserted",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "{{colors.green.default.hex}}"
      }
    },
    {
      "scope": [
        "string.regexp",
        "constant.character",
        "constant.other.placeholder",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "{{colors.cyan.default.hex}}"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "{{colors.blue.default.hex}}"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "{{colors.magenta.default.hex}}"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "{{colors.on_surface_variant.default.hex}}"
      }
    },
    {
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "{{colors.yellow.default.hex}}"
      }
    },
    {
      "scope": [
        "markup.heading",
        "markup.heading entity.name"
      ],
      "settings": {
        "foreground": "{{colors.blue.default.hex}}",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "{{colors.orange.default.hex}}",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "{{colors.magenta.default.hex}}",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "{{colors.cyan.default.hex}}",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "{{colors.red.default.hex}}"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "{{colors.yellow.default.hex}}"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "{{colors.outline.default.hex}}",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "{{colors.error.default.hex}}"
      }
    }
  ],
  "semanticTokenColors": {
    "comment": "{{colors.outline.default.hex}}",
    "parameter": "{{colors.on_surface_variant.default.hex}}",
