    "type": "{{colors.yellow.default.hex}}",
    "class": "{{colors.yellow.default.hex}}",
    "interface": "{{colors.yellow.default.hex}}",
    "namespace": "{{colors.yellow.default.hex}}",
    "function": "{{colors.blue.default.hex}}",
    "method": "{{colors.blue.default.hex}}",
    "macro": "{{colors.cyan.default.hex}}",
    "keyword": "{{colors.magenta.default.hex}}",
    "string": "{{colors.green.default.hex}}",
    "number": "{{colors.orange.default.hex}}",
    "*.defaultLibrary": {
