# Generated by chromix from a matugen template. Changes are lost on the
# next theme switch.
#
# Pulled in with include.path, so git reads it on every command. The
# colours are quoted: a bare # would start a comment.

[color "diff"]
	meta = "{{colors.on_surface_variant.default.hex}} bold"
	frag = "{{colors.tertiary.default.hex}}"
	func = "{{colors.on_surface_variant.default.hex}}"
	commit = "{{colors.yellow.default.hex}}"
	old = "{{colors.red.default.hex}}"
	new = "{{colors.green.default.hex}}"
	oldMoved = "{{colors.magenta.default.hex}}"
	newMoved = "{{colors.cyan.default.hex}}"
	whitespace = "{{colors.on_error.default.hex}} {{colors.error.default.hex}}"

[color "status"]
	header = "{{colors.outline.default.hex}}"
	branch = "{{colors.primary.default.hex}} bold"
	added = "{{colors.green.default.hex}}"
	changed = "{{colors.yellow.default.hex}}"
	untracked = "{{colors.red.default.hex}}"
	unmerged = "{{colors.magenta.default.hex}}"
	nobranch = "{{colors.error.default.hex}} bold"

[color "branch"]
	current = "{{colors.primary.default.hex}} bold"
	local = "{{colors.on_surface.default.hex}}"
	remote = "{{colors.tertiary.default.hex}}"
	upstream = "{{colors.cyan.default.hex}}"

[color "decorate"]
	HEAD = "{{colors.primary.default.hex}} bold"
	branch = "{{colors.green.default.hex}} bold"
	remoteBranch = "{{colors.tertiary.default.hex}} bold"
	tag = "{{colors.yellow.default.hex}} bold"
	stash = "{{colors.magenta.default.hex}}"
	grafted = "{{colors.outline.default.hex}}"

[color "grep"]
	filename = "{{colors.magenta.default.hex}}"
	linenumber = "{{colors.green.default.hex}}"
	match = "{{colors.red.default.hex}} bold"
	separator = "{{colors.outline.default.hex}}"
