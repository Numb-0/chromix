<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Generated by chromix from a matugen template. Changes are lost on the
  next theme switch.

  A TextMate theme for yazi's code previews, laid out as the base16
  palette the neovim target builds, so a file previews in the colours
  it opens in: neutrals from the surface and outline roles, and one
  custom colour per base08 to base0e slot.
-->
<plist version="1.0">
<dict>
	<key>name</key>
	<string>chromix</string>
	<key>settings</key>
	<array>
		<dict>
			<key>settings</key>
			<dict>
				<key>background</key>
				<string>{{colors.surface_container_high.default.hex}}</string>
				<key>foreground</key>
				<string>{{colors.on_surface.default.hex}}</string>
				<key>caret</key>
				<string>{{colors.on_surface.default.hex}}</string>
				<key>invisibles</key>
				<string>{{colors.outline_variant.default.hex}}</string>
				<key>lineHighlight</key>
				<string><* if {{ is_dark_mode }} *>{{colors.surface_container_highest.default.hex}}<* else *>{{colors.surface_dim.default.hex}}<* endif *></string>
				<key>selection</key>
				<string>{{colors.primary_container.default.hex}}</string>
				<key>selectionForeground</key>
				<string>{{colors.on_primary_container.default.hex}}</string>
			</dict>
		</dict>

		<!-- base03: comments -->
		<dict>
			<key>name</key>
			<string>Comment</string>
			<key>scope</key>
			<string>comment, punctuation.definition.comment</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>{{colors.outline.default.hex}}</string>
				<key>fontStyle</key>
				<string>italic</string>
			</dict>
		</dict>

		<!-- base05 and base0f: plain text and delimiters -->
		<dict>
			<key>name</key>
			<string>Delimiters</string>
			<key>scope</key>
			<string>punctuation.separator, punctuation.terminator, punctuation.section, meta.brace</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>{{colors.on_surface_variant.default.hex}}</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Operators</string>
			<key>scope</key>
			<string>keyword.operator</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>{{colors.on_surface.default.hex}}</string>
			</dict>
		</dict>

		<!-- base08: variables, tags, deletions -->
		<dict>
			<key>name</key>
			<string>Variables</string>
			<key>scope</key>
			<string>variable, variable.other, variable.parameter, entity.name.tag, markup.deleted, punctuation.definition.variable</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>{{colors.red.default.hex}}</string>
			</dict>
		</dict>

		<!-- base09: constants, numbers, attributes -->
		<dict>
			<key>name</key>
			<string>Constants</string>
			<key>scope</key>
			<string>constant, constant.numeric, constant.language, constant.character, entity.other.attribute-name, support.constant, markup.link.url</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>{{colors.orange.default.hex}}</string>
			</dict>
		</dict>

		<!-- base0a: types, classes, bold -->
		<dict>
			<key>name</key>
			<string>Types</string>
			<key>scope</key>
			<string>entity.name.type, entity.name.class, entity.other.inherited-class, support.type, support.class, storage.type.class, markup.bold, markup.changed</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>{{colors.yellow.default.hex}}</string>
			</dict>
		</dict>

		<!-- base0b: strings, insertions -->
		<dict>
			<key>name</key>
			<string>Strings</string>
			<key>scope</key>
			<string>string, punctuation.definition.string, markup.inserted, markup.raw, markup.quote</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>{{colors.green.default.hex}}</string>
			</dict>
		</dict>

		<!-- base0c: escapes, regexes, support -->
		<dict>
			<key>name</key>
			<string>Escapes</string>
			<key>scope</key>
			<string>constant.character.escape, string.regexp, support.function.builtin, markup.italic</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>{{colors.cyan.default.hex}}</string>
			</dict>
		</dict>

		<!-- base0d: functions, headings -->
		<dict>
			<key>name</key>
			<string>Functions</string>
			<key>scope</key>
			<string>entity.name.function, support.function, meta.function-call, variable.function, markup.heading, entity.name.section</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>{{colors.blue.default.hex}}</string>
			</dict>
		</dict>

		<!-- base0e: keywords, storage -->
		<dict>
			<key>name</key>
			<string>Keywords</string>
			<key>scope</key>
			<string>keyword, keyword.control, storage, storage.type, storage.modifier, entity.name.namespace, meta.selector</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>{{colors.magenta.default.hex}}</string>
			</dict>
		</dict>

		<dict>
			<key>name</key>
			<string>Invalid</string>
			<key>scope</key>
			<string>invalid</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>{{colors.on_error_container.default.hex}}</string>
				<key>background</key>
				<string>{{colors.error_container.default.hex}}</string>
			</dict>
		</dict>
	</array>
</dict>
</plist>
